{
  "name": "rump",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:browser": "node scripts/verify-browser.mjs",
    "check:content": "bun scripts/check-content.ts",
    "render:pitch": "remotion render RumpPitch out/rump-pitch.mp4",
    "render:60": "remotion render Rump60 out/rump-60.mp4",
    "audio:60": "bun scripts/align-short-narration.ts",
    "render:demo": "remotion render RumpDemo out/rump-demo.mp4",
    "render:draft": "remotion render RumpPitch out/rump-draft.mp4 --scale=0.5 --crf=28",
    "render:slides": "bun scripts/render-slides.ts",
    "studio": "remotion studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/tailwind-v4": "4.0.532",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "remotion": "4.0.532",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
